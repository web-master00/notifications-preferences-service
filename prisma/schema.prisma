generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  EMAIL
  SMS
  PUSH
}

enum NotificationType {
  TRANSACTIONAL_EMAIL
  MARKETING_EMAIL
  MARKETING_SMS
  MARKETING_PUSH
}

enum Region {
  EU
  US
  APAC
}

model DefaultPreference {
  id Int @id @default(autoincrement())

  notificationType NotificationType
  channel          Channel

  enabled Boolean

  @@unique([notificationType, channel])
}

model UserPreference {
  id String @id @default(uuid())

  userId String

  notificationType NotificationType
  channel          Channel

  enabled Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, notificationType, channel])
  @@index([userId])
}

model QuietHours {
  id String @id @default(uuid())

  userId String @unique

  timezone String

  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GlobalPolicy {
  id String @id @default(uuid())

  region Region

  notificationType NotificationType
  channel          Channel

  enabled Boolean

  @@unique([region, notificationType, channel])
}
